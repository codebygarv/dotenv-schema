{
  "name": "env-shield",
  "version": "1.0.0",
  "description": "Validate, secure, document, audit, and manage environment variables with confidence.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "import": "./dist/adapters/next.js",
      "require": "./dist/adapters/next.cjs"
    },
    "./vite": {
      "import": "./dist/adapters/vite.js",
      "require": "./dist/adapters/vite.cjs"
    }
  },
  "bin": {
    "env-sentinel": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationMap false",
    "build:action": "esbuild src/action/index.ts --bundle --platform=node --target=node20 --outfile=dist/action/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "dotenv",
    "environment",
    "schema",
    "validation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "cac": "^7.0.0",
    "dotenv": "^17.4.2",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1"
  }
}
